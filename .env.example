# Copy to .env and fill in. Never commit the filled-in file.
# Devin service-user key (Settings -> API keys). Starts with cog_ or apk_.
DEVIN_API_KEY=
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub App credentials (see README: "Register a repository").
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# Paste the whole .pem, newlines included:
#   GITHUB_APP_PRIVATE_KEY="$(cat mend.private-key.pem)"
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Repositories to seed into the registry on first boot (comma-separated).
MEND_REPO=udaysagarn/superset

# Read-only demo: browse the dashboard without calling GitHub or Devin.
MEND_ENGINE_ENABLED=true
MEND_POLLING_ENABLED=true
