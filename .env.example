# Copy to .env and fill in. Never commit the filled-in file.
# Devin service-user key (Settings -> API keys). Starts with cog_ or apk_.
DEVIN_API_KEY=
DEVIN_ORG_ID=org-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# GitHub App credentials (see README: "Register a repository").
GITHUB_APP_ID=
GITHUB_APP_INSTALLATION_ID=
# The whole .pem, newlines included. This file is read literally — nothing here is
# expanded, so a $(cat ...) written below arrives as those characters. Append it from
# a shell instead, or set the path of the .pem, or its base64:
#   echo "GITHUB_APP_PRIVATE_KEY=\"$(cat mend.private-key.pem)\"" >> .env
#   GITHUB_APP_PRIVATE_KEY=/absolute/path/to/mend.private-key.pem
#   GITHUB_APP_PRIVATE_KEY=$(base64 -w0 mend.private-key.pem)   # run in a shell, paste the result
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# The default repository, seeded into the registry on first boot.
MEND_REPO=udaysagarn/superset
# Additional repositories to seed, comma-separated. Optional.
MEND_REPOS=

# Read-only demo: browse the dashboard without calling GitHub or Devin.
MEND_ENGINE_ENABLED=true
MEND_POLLING_ENABLED=true
